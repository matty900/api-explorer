generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Api {
  id          String   @id @default(cuid())
  name        String
  description String
  category    String
  authType    String   @default("none")
  baseUrl     String
  docsUrl     String
  tags        String[] @default([])
  endpoints   Json     @default("[]")
  createdAt   DateTime @default(now())

  @@index([category])
  @@index([name])
}

// Holding area for community submitted APIs (via the public web form). Kept
// entirely separate from `Api` so nothing unreviewed can ever appear in
// search results or be proxied — a submission only reaches `Api` by being
// promoted through addApi() when a maintainer approves it.
model ApiSubmission {
  id             String    @id @default(cuid())
  name           String
  description    String
  category       String
  authType       String
  baseUrl        String
  docsUrl        String
  tags           String[]  @default([])
  endpoints      Json      @default("[]")
  status         String    @default("pending") // pending | approved | rejected
  submitterEmail String?
  reviewNote     String?
  createdAt      DateTime  @default(now())
  reviewedAt     DateTime?

  @@index([status])
}

model User {
  id        String   @id @default(cuid())
  email     String?  @unique
  name      String?
  githubId  String?  @unique
  plan      String   @default("free")
  createdAt DateTime @default(now())

  requestHistory RequestHistory[]
}

model RequestHistory {
  id         String   @id @default(cuid())
  userId     String
  apiName    String
  method     String
  url        String
  status     Int
  durationMs Int
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
